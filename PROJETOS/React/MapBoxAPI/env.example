# Copie para .env.local (cp .env.example .env.local) e preencha.
# Aqui o prefixo VITE_ é necessário: o token público (pk.) é usado pelo mapa no navegador.
# Restrinja o token por URL no painel do Mapbox: https://console.mapbox.com/account/access-tokens/
# Na Vercel, depois de alterar a variável, faça o Redeploy (variáveis VITE_ entram no build).

VITE_MAPBOX_TOKEN=
