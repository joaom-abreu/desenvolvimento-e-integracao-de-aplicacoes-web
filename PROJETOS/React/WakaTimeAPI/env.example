# Copie para .env.local (cp .env.example .env.local) e preencha.
# NÃO use o prefixo VITE_: a chave é secreta e é lida só no servidor
# (vite.config.js no npm run dev e api/wakatime.js + api/codando.js na Vercel).

# API key do WakaTime (começa com waka_): https://wakatime.com/settings/api-key
WAKATIME_API_KEY=

# Opcional (só é usado quando NÃO há chave): usuário com perfil público
WAKATIME_USERNAME=

# Opcional: projetos que aparecem pelo nome no "Codando agora", separados por
# vírgula. Soma com CODING_NOW.PUBLIC_PROJECTS do src/config/wakatimeConfig.js.
WAKATIME_PUBLIC_PROJECTS=
