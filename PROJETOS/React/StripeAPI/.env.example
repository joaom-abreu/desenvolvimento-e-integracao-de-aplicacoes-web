# Copie para .env.local (cp .env.example .env.local) e preencha.
# As duas chaves estão em https://dashboard.stripe.com/test/apikeys
# Use SEMPRE as chaves de TESTE (pk_test_ e sk_test_), e as duas da MESMA conta.
# No modo de teste nenhum dinheiro de verdade é movimentado.

# Chave PUBLICÁVEL (pk_test_...): vai para o navegador, por isso TEM o prefixo VITE_.
# Ela só abre o formulário de cartão; não consegue cobrar nem ler pagamentos.
# Na Vercel, depois de alterar esta variável, faça o Redeploy (variáveis VITE_ entram no build).
VITE_STRIPE_PUBLISHABLE_KEY=

# Chave SECRETA (sk_test_...): SEM o prefixo VITE_. É lida só no servidor
# (vite.config.js no npm run dev e api/stripe.js na Vercel). Nunca suba para o GitHub.
STRIPE_SECRET_KEY=
