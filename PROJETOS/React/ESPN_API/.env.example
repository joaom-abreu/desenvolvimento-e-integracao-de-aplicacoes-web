# Opcional: copie para .env.local (cp .env.example .env.local) para trocar
# o time, a liga ou o fuso sem mexer no código. Sem o .env.local, o projeto
# usa os valores padrão de src/config/espnConfig.js.
#
# A API pública da ESPN NÃO pede chave: nada aqui é segredo. Por isso as
# variáveis usam o prefixo VITE_ (o Vite as coloca no JavaScript do navegador).
# Depois de alterar, reinicie o npm run dev (na Vercel, faça o Redeploy).

# Time do futebol (id da ESPN, está na URL do time):
# espn.com.br/futebol/time/_/id/7632/atletico-mg → 7632
VITE_SOCCER_TEAM_ID=7632

# Liga da tabela e da lista de times (bra.1 = Série A, bra.2 = Série B)
VITE_SOCCER_LEAGUE=bra.1
VITE_SOCCER_LEAGUE_NAME=Brasileirão Série A

# Time da NBA ao abrir a aba Basquete (sigla da ESPN: lal, gs, bos...).
# Vazio = a liga toda
VITE_NBA_TEAM=

# Fuso das datas e horas dos jogos
VITE_TIMEZONE=America/Sao_Paulo
