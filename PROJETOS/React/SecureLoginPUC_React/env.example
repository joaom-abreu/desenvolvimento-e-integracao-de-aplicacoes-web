# Copie para .env.local (cp .env.example .env.local) e preencha.
# Tudo é opcional: sem estas variáveis o projeto abre normalmente.

# EmailJS (https://dashboard.emailjs.com/admin)
# Sem elas, o link de recuperação de senha aparece no console do navegador.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID_RECOVERY=
VITE_EMAILJS_PUBLIC_KEY=

# Google reCAPTCHA v2 "Não sou um robô" (https://www.google.com/recaptcha/admin)
# Sem ela, é usada a chave de teste oficial do Google. Use só a Site key (nunca a Secret key).
VITE_RECAPTCHA_SITE_KEY=
