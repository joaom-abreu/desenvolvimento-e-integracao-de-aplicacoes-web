# Copie para .env.local (cp .env.example .env.local) e preencha.
# NÃO use o prefixo VITE_: o token é secreto e é lido só no servidor
# (vite.config.js no npm run dev e api/canvas.js na Vercel).

# Token de acesso do Canvas: Conta → Configurações → Integrações aprovadas
# → "+ Novo token de acesso"
CANVAS_TOKEN=

# Endereço do Canvas da sua instituição (padrão: PUC Minas)
CANVAS_URL=https://pucminas.instructure.com

# Opcional: ids dos cursos que aparecem no painel, separados por vírgula.
# Vazio = todos os cursos ativos. O id está na URL: .../courses/292753
CANVAS_COURSES=
