# ---------- Supabase ----------
# Project Settings > Data API > Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Project Settings > API Keys > Publishable key (sb_publishable_...)
# A chave "anon" (legacy) também funciona.
# NUNCA coloque aqui a secret key / service_role: tudo que começa com VITE_ vai para o navegador.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Radio Browser API (opcional) ----------
# Mesmo papel do radio.api.base.url do application.properties. Outros espelhos: de2, fi1...
VITE_RADIO_API_BASE_URL=https://de1.api.radio-browser.info/json
