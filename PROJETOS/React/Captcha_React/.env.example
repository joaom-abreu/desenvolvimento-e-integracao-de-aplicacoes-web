# Copie para .env.local (cp .env.example .env.local) e preencha.
# Tudo é opcional: sem estas variáveis o projeto usa as CHAVES DE TESTE oficiais
# de cada provedor (o captcha sempre passa). Só o reCAPTCHA v3 precisa de chave real.
#
#   VITE_*  → SITE KEY (pública): vai para o navegador.
#   sem VITE_ → SECRET KEY (secreta): lida só no servidor
#              (vite.config.js no npm run dev e pasta api/ na Vercel).
#
# NUNCA coloque uma SECRET KEY com o prefixo VITE_.

# ---------------------------------------------------------------------------
# Google reCAPTCHA v2 - checkbox ("Não sou um robô")
# https://www.google.com/recaptcha/admin  → tipo "v2 > Caixa de seleção"
# ---------------------------------------------------------------------------
VITE_RECAPTCHA_V2_CHECKBOX_SITE_KEY=
RECAPTCHA_V2_CHECKBOX_SECRET_KEY=

# ---------------------------------------------------------------------------
# Google reCAPTCHA v2 - invisível
# https://www.google.com/recaptcha/admin  → tipo "v2 > Selo invisível"
# ---------------------------------------------------------------------------
VITE_RECAPTCHA_V2_INVISIVEL_SITE_KEY=
RECAPTCHA_V2_INVISIVEL_SECRET_KEY=

# ---------------------------------------------------------------------------
# Google reCAPTCHA v3 (pontuação de 0.0 a 1.0)
# O Google NÃO oferece chave de teste para o v3: crie uma chave
# "v3 (baseado em pontuação)" e adicione "localhost" nos domínios.
# ---------------------------------------------------------------------------
VITE_RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
# RECAPTCHA_V3_SCORE_MINIMO=0.5

# ---------------------------------------------------------------------------
# hCaptcha
# https://dashboard.hcaptcha.com  (site key em Sites; secret em Settings)
# ---------------------------------------------------------------------------
VITE_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile
# https://dash.cloudflare.com  → Turnstile → Add widget
# ---------------------------------------------------------------------------
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# ALTCHA (prova de trabalho, sem conta em nenhum serviço)
# A chave HMAC é inventada por você: gere com  openssl rand -base64 48
# ---------------------------------------------------------------------------
ALTCHA_HMAC_KEY=
# ALTCHA_MAX_NUMBER=100000
# ALTCHA_VALIDADE_MINUTOS=10

# ---------------------------------------------------------------------------
# Captcha de imagem e captcha matemático (gerados pelo próprio projeto)
# Chave que assina os desafios (substitui a HttpSession do Spring).
# Também é inventada por você: openssl rand -base64 48
# ---------------------------------------------------------------------------
DESAFIO_HMAC_KEY=
# CAPTCHA_IMAGEM_TAMANHO=5
