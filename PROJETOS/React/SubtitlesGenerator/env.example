# Copie para .env.local (cp .env.example .env.local) e preencha.
# NÃO use o prefixo VITE_: a chave é secreta e é lida só no servidor
# (vite.config.js no npm run dev e api/subtitles.js na Vercel).

# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: trocar o modelo (padrão: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash
