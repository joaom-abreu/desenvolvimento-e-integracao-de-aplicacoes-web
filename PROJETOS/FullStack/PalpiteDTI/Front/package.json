{
  "name": "palpitedti",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Front-end (React + Vite) do PalpiteDTI: jogo de adivinhação de 1 a 100 - teste técnico dti Rackers",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "back": "cd ../Back && ./mvnw spring-boot:run",
    "back:windows": "cd ..\\Back && mvnw.cmd spring-boot:run",
    "dev:all": "concurrently --names \"BACK,FRONT\" --prefix-colors \"blue,cyan\" \"npm run back\" \"npm run dev\"",
    "dev:all:windows": "concurrently --names \"BACK,FRONT\" --prefix-colors \"blue,cyan\" \"npm run back:windows\" \"npm run dev\""
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "@fontsource/red-hat-display": "5.3.0",
    "@fontsource/red-hat-text": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "concurrently": "10.0.6",
    "jsdom": "30.1.2",
    "postcss": "8.5.30",
    "sass": "1.105.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
