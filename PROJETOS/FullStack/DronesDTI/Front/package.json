{
  "name": "dronesdti",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Front-end (React + Vite) do Simulador de Entregas por Drone - case técnico dti digital",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "back": "cd ../Back && ./mvnw spring-boot:run",
    "back:windows": "cd ..\\Back && mvnw.cmd spring-boot:run",
    "dev:all": "concurrently --names \"BACK,FRONT\" --prefix-colors \"blue,cyan\" \"npm run back\" \"npm run dev\"",
    "dev:all:windows": "concurrently --names \"BACK,FRONT\" --prefix-colors \"blue,cyan\" \"npm run back:windows\" \"npm run dev\""
  },
  "dependencies": {
    "@fontsource/red-hat-display": "^5.3.0",
    "@fontsource/red-hat-text": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
