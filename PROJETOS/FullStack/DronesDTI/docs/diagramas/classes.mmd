classDiagram
    direction LR
    class Pedido {
      String id
      String cliente
      double x, y, pesoKg
      Prioridade prioridade
      StatusPedido status
      Instant criadoEm, entregueEm
      String droneId, viagemId
    }
    class Drone {
      String id, nome
      double capacidadeKg
      double alcanceKm
      double velocidadeKmh
      double bateria
      EstadoDrone estado
      double x, y
      alcanceDisponivelKm()
    }
    class Viagem {
      String id, droneId
      StatusViagem status
      Instant inicio, fim
      double distanciaKm, pesoKg
      String algoritmo
      List~Parada~ paradas
      List~Ponto~ caminho
      List~Fase~ fases
    }
    class ZonaExclusao {
      String nome
      double xMin, yMin, xMax, yMax
      contem(Ponto)
    }
    class Parada {
      <<record>>
      int ordem
      double kmAcumulado
      double minutoChegada
    }
    class Fase {
      <<record>>
      EstadoDrone estado
      double inicioMin, fimMin
    }
    Drone "1" --> "0..1" Viagem : viagemAtual
    Viagem "1" *-- "1..*" Parada
    Viagem "1" *-- "1..*" Fase
    Viagem "1" --> "1..*" Pedido
