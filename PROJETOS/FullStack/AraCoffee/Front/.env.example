# Copie este arquivo para .env e preencha os valores.
# O Vite só lê o .env ao iniciar: reinicie o npm run dev depois de mudar.

# URL do back-end (Spring Boot). Vazio = http://localhost:8080
# No Vercel: a URL do Render, com https:// e sem / no final
VITE_API_URL=

# EmailJS (formulário de Contato)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
