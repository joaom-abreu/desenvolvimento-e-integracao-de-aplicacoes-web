# URL do back-end Spring Boot.
#
# Rodando no seu computador você NÃO precisa deste arquivo:
# sem ele, o front usa http://localhost:8080 automaticamente.
#
# No Vercel, cadastre esta variável em Settings > Environment Variables
# com a URL que o Render gerou para o back-end (sem barra no final):
VITE_API_URL=https://exemplo-integracao-back.onrender.com
